---
import { Image } from "astro:assets";
import MyProjects from "../libraries/me/knowledges/projects";
import SectionHead from "./section-head.astro";
---

<section id="projects" class="section">
  <div class="container">
    <SectionHead
      name="projects"
      label="Projects"
      title="Things I've shipped"
      sub="Apps published on the stores and open sourced on GitHub."
    />

    <div class="grid">
      {
        MyProjects.map((project, i) => (
          <article
            class="card card-interactive project-card reveal reveal-scale"
            style={`--delay: ${(i % 3) * 0.08}s`}
          >
            <div class="project-cover">
              <Image
                src={project.image}
                alt={project.name}
                width={184}
                height={184}
              />
            </div>
            <div class="project-body">
              <h3 class="item-title">{project.name}</h3>
              <p
                class="item-desc"
                data-desc-en={project.description.en}
                data-desc-es={project.description.es}
              >
                {project.description.en}
              </p>
              <div class="project-links">
                {project.playstore && (
                  <a
                    href={project.playstore}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="pill-link"
                  >
                    <i class="fab fa-google-play" /> Google Play
                  </a>
                )}
                {project.appstore && (
                  <a
                    href={project.appstore}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="pill-link"
                  >
                    <i class="fab fa-app-store-ios" /> App Store
                  </a>
                )}
                {project.github && (
                  <a
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="pill-link"
                  >
                    <i class="fab fa-github" /> GitHub
                  </a>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
