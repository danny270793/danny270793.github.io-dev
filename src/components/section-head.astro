---
interface Props {
  name:
    | "education"
    | "certifications"
    | "libraries"
    | "projects"
    | "technologies"
    | "contact";
  label: string;
  title: string;
  sub: string;
}

const { name, label, title, sub } = Astro.props;
---

<div class="section-head reveal">
  <span class="section-label" data-i18n={`sections.${name}`}>{label}</span>
  <h2 class="section-title" data-i18n={`headings.${name}`}>{title}</h2>
  <p class="section-sub" data-i18n={`subs.${name}`}>{sub}</p>
</div>
