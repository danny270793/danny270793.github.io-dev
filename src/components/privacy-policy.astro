---
import { Image } from "astro:assets";
import type {
  AppPrivacy,
  DataStatus,
} from "../libraries/me/knowledges/privacy";

interface Props {
  app: AppPrivacy;
}

const { app } = Astro.props;
const { project } = app;
const email = "danny270793@gmail.com";

const statuses: Record<DataStatus, { label: string; icon: string }> = {
  no: { label: "Not collected", icon: "fas fa-times" },
  device: { label: "Only on device", icon: "fas fa-mobile-alt" },
  cloud: { label: "Stored in Supabase", icon: "fas fa-cloud" },
  shared: { label: "Shared with players", icon: "fas fa-users" },
};

const num = (i: number) => String(i + 1).padStart(2, "0");
---

<section class="page-hero">
  <div class="container">
    <div class="section-head reveal reveal-blur">
      <span class="section-label">Privacy Policy</span>
      <h1 class="section-title">{project.name}</h1>
      <p class="section-sub">
        Effective date: {app.effectiveDate}. {app.tagline}
      </p>
    </div>
  </div>
</section>

<section class="section policy">
  <div class="container policy-container">
    <div class="card policy-app reveal reveal-scale">
      <div class="item-logo policy-app-logo">
        <Image
          src={project.image}
          alt={project.name}
          width={128}
          height={128}
        />
      </div>
      <div class="item-body">
        <h2 class="item-title">{project.name}</h2>
        <p class="item-desc">{project.description.en}</p>
        <div class="project-links">
          {
            project.playstore && (
              <a
                href={project.playstore}
                target="_blank"
                rel="noopener noreferrer"
                class="pill-link"
              >
                <i class="fab fa-google-play" /> Google Play
              </a>
            )
          }

          {
            project.appstore && (
              <a
                href={project.appstore}
                target="_blank"
                rel="noopener noreferrer"
                class="pill-link"
              >
                <i class="fab fa-app-store-ios" /> App Store
              </a>
            )
          }

          {
            project.github && (
              <a
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
                class="pill-link"
              >
                <i class="fab fa-github" /> GitHub
              </a>
            )
          }
        </div>
      </div>
    </div>

    <div class="policy-block reveal">
      <h2 class="policy-heading">
        <span class="policy-num">{num(0)}</span>
        What information is involved?
      </h2>
      <p>At a glance, what the app touches and where it ends up:</p>
      <div class="policy-grid">
        {
          app.data.map((item, i) => (
            <div
              class={`card policy-item policy-item-${item.status} reveal reveal-tilt`}
              style={`--delay: ${i * 0.06}s`}
            >
              <span class="policy-item-icon">
                <i class={item.icon} />
                <i
                  class={`${item.status === "no" ? "fas fa-ban" : statuses[item.status].icon} policy-ban`}
                  aria-hidden="true"
                />
              </span>
              <h3>{item.label}</h3>
              {item.desc && <p>{item.desc}</p>}
            </div>
          ))
        }
      </div>
    </div>

    {
      app.sections.map((section, i) => (
        <div class="policy-block reveal">
          <h2 class="policy-heading">
            <span class="policy-num">{num(i + 1)}</span>
            {section.title}
          </h2>
          {section.paragraphs.map((p) => (
            <p>{p}</p>
          ))}
        </div>
      ))
    }

    <div class="policy-block reveal">
      <h2 class="policy-heading">
        <span class="policy-num">{num(app.sections.length + 1)}</span>
        Summary
      </h2>
      <div class="card policy-summary">
        <div class="policy-row policy-row-head">
          <span>Data type</span>
          <span>Where it goes</span>
        </div>

        {
          app.data.map((item, i) => (
            <div class="policy-row stagger" style={`--i: ${i * 2}`}>
              <span>{item.label}</span>
              <span class={`policy-no policy-status-${item.status}`}>
                <i class={statuses[item.status].icon} />{" "}
                {statuses[item.status].label}
              </span>
            </div>
          ))
        }

        <div class="policy-row stagger" style={`--i: ${app.data.length * 2}`}>
          <span>Sold or used for ads</span>
          <span class="policy-no policy-status-no">
            <i class="fas fa-times"></i> Never
          </span>
        </div>
      </div>
    </div>

    <div class="contact-card policy-contact reveal" data-enter>
      <div class="section-head">
        <span class="section-label">Contact</span>
        <h2 class="section-title">Questions about this policy?</h2>
        <p class="section-sub">
          If you have any questions about this privacy policy, or want your data
          deleted, please contact us at:
        </p>
      </div>
      <div class="contact-links">
        <a href={`mailto:${email}`} class="btn btn-primary">
          <i class="fas fa-envelope"></i>

          {email}
        </a>
      </div>
    </div>

    <a href="/privacy" class="btn btn-ghost policy-back reveal">
      <i class="fas fa-arrow-left"></i>
      All privacy policies
    </a>
  </div>
</section>
