---
import MyTechnologies from "../libraries/me/knowledges/technologies";
import type { Technology } from "../libraries/me/knowledges/technologies";
import SectionHead from "./section-head.astro";

const categories = [
  ...new Set(MyTechnologies.map((e: Technology) => e.category)),
];

const meta: Record<string, { es: string; icon: string }> = {
  Mobile: { es: "Móvil", icon: "fas fa-mobile-alt" },
  Web: { es: "Web", icon: "fas fa-code" },
  "CI/CD": { es: "CI/CD", icon: "fas fa-infinity" },
  Deployments: { es: "Despliegues", icon: "fas fa-rocket" },
  Monitoring: { es: "Monitoreo", icon: "fas fa-chart-line" },
  Storage: { es: "Almacenamiento", icon: "fas fa-database" },
  BigData: { es: "Big Data", icon: "fas fa-layer-group" },
  Microcontrollers: { es: "Microcontroladores", icon: "fas fa-microchip" },
};
---

<section id="technologies" class="section">
  <div class="container">
    <SectionHead
      name="technologies"
      label="Technologies"
      title="My toolbox"
      sub="The technologies I use to design, build, deploy and monitor software."
    />

    <div class="grid grid-2">
      {
        categories.map((category, i) => {
          const items = MyTechnologies.filter(
            (t: Technology) => t.category === category,
          );
          return (
            <div
              class="card tech-card reveal"
              style={`--delay: ${(i % 2) * 0.08}s`}
            >
              <div class="tech-head">
                <span class="tech-icon">
                  <i class={meta[category]?.icon ?? "fas fa-cubes"} />
                </span>
                <h3
                  class="tech-name"
                  data-desc-en={category}
                  data-desc-es={meta[category]?.es ?? category}
                >
                  {category}
                </h3>
                <span class="tech-count">{items.length}</span>
              </div>
              <div class="tech-badges">
                {items.map((technology: Technology) => (
                  <span class="tech-badge">{technology.alternative}</span>
                ))}
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
