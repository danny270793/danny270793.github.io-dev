---
import { Image } from "astro:assets";
import MyEducations from "../libraries/me/knowledges/educations";
import type { Education } from "../libraries/me/knowledges/educations";
import SectionHead from "./section-head.astro";
---

<section id="education" class="section">
  <div class="container">
    <SectionHead
      name="education"
      label="Education"
      title="Academic foundation"
      sub="Formal training in engineering and information systems."
    />

    <div class="timeline">
      {
        MyEducations.map((education: Education, i: number) => (
          <div
            class="timeline-item reveal reveal-left"
            style={`--delay: ${i * 0.1}s`}
          >
            <span class="timeline-dot" />
            <div class="card item-card">
              <div class="item-logo">
                <Image
                  src={education.image}
                  alt={education.institution}
                  width={128}
                  height={128}
                />
              </div>
              <div class="item-body">
                <span class="timeline-years">
                  {education.from} — {education.to}
                </span>
                <h3 class="item-title">{education.name}</h3>
                <p class="item-desc">{education.institution}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
