---
import { Image } from "astro:assets";
import Certifications, {
  CategoryOrder,
} from "../libraries/me/knowledges/certifications";

const categories = [
  ...new Set(
    Certifications.map((c) => c.category).sort(
      (a, b) => CategoryOrder[a] - CategoryOrder[b],
    ),
  ),
];
---

<section class="page-hero">
  <div class="container">
    <div class="section-head reveal">
      <span class="section-label" data-i18n="sections.certifications"
        >Certifications</span
      >
      <h1 class="section-title" data-i18n="headings.certifications">
        Validated expertise
      </h1>
      <p class="section-sub" data-i18n="subs.certifications">
        Industry certifications across cloud, data, automation and more.
      </p>
    </div>
  </div>
</section>

<section class="section" style="padding-top: 1rem;">
  <div class="container">
    {
      categories.map((category) => {
        const items = Certifications.filter(
          (c) => c.category === category,
        ).sort((a, b) => a.order - b.order);
        return (
          <div class="cert-gallery-group reveal">
            <h2 class="cert-gallery-title">
              {category}
              <span class="tag">{items.length}</span>
            </h2>
            <div class="cert-gallery">
              {items.map((certification) => (
                <a
                  href={certification.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="card card-interactive cert-tile"
                  title={certification.name}
                >
                  <Image
                    src={certification.image}
                    alt={certification.name}
                    width={320}
                  />
                </a>
              ))}
            </div>
          </div>
        );
      })
    }
  </div>
</section>
