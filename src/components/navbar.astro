---
const { anchors = true } = Astro.props;
const prefix = anchors ? "" : "/";

const links = [
  { id: "about-me", key: "nav.about", label: "About" },
  { id: "education", key: "nav.education", label: "Education" },
  { id: "certifications", key: "nav.certifications", label: "Certifications" },
  { id: "open-source-libraries", key: "nav.libraries", label: "Libraries" },
  { id: "projects", key: "nav.projects", label: "Projects" },
  { id: "technologies", key: "nav.technologies", label: "Technologies" },
  { id: "contact", key: "nav.contact", label: "Contact" },
];

const themes = [
  { val: "system", icon: "fas fa-adjust", label: "System" },
  { val: "light", icon: "fas fa-sun", label: "Light" },
  { val: "dark", icon: "fas fa-moon", label: "Dark" },
];

const langs = [
  { val: "system", label: "System", short: "Auto" },
  { val: "en", label: "English", short: "EN" },
  { val: "es", label: "Español", short: "ES" },
];
---

<header id="navbar" class="nav">
  <div class="container nav-inner">
    <a href={anchors ? "#top" : "/"} class="brand" aria-label="Danny Vaca">
      <span class="brand-mark">DV</span>
      <span>Danny Vaca</span>
    </a>

    <ul class="nav-links">
      {
        links.map((l) => (
          <li>
            <a
              href={`${prefix}#${l.id}`}
              class="nav-link"
              data-section={l.id}
              data-i18n={l.key}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="nav-actions">
      <div class="picker">
        <button
          type="button"
          class="icon-btn picker-toggle"
          aria-label="Change theme"
        >
          <i class="theme-icon fas fa-adjust"></i>
        </button>
        <ul class="picker-menu">
          {
            themes.map((t) => (
              <li class="picker-option" data-theme-val={t.val}>
                <i class={t.icon} />
                {t.label}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="picker">
        <button
          type="button"
          class="icon-btn picker-toggle"
          aria-label="Change language"
        >
          <i class="fas fa-globe"></i>
          <span class="lang-current">Auto</span>
        </button>
        <ul class="picker-menu">
          {
            langs.map((l) => (
              <li class="picker-option" data-lang={l.val}>
                {l.label}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <button
      type="button"
      class="icon-btn menu-btn"
      id="menu-open"
      aria-label="Open menu"
    >
      <i class="fas fa-bars"></i>
    </button>
  </div>
</header>

<div class="drawer-backdrop" id="drawer-backdrop"></div>
<aside class="drawer" id="drawer" aria-label="Menu">
  <div class="drawer-head">
    <span class="brand">
      <span class="brand-mark">DV</span>
      <span>Danny Vaca</span>
    </span>
    <button
      type="button"
      class="icon-btn"
      id="menu-close"
      aria-label="Close menu"
    >
      <i class="fas fa-times"></i>
    </button>
  </div>

  <ul class="drawer-links">
    {
      links.map((l) => (
        <li>
          <a href={`${prefix}#${l.id}`} class="nav-link" data-i18n={l.key}>
            {l.label}
          </a>
        </li>
      ))
    }
  </ul>

  <div>
    <span class="drawer-group-label" data-i18n="settings.theme">Theme</span>
    <div class="segmented">
      {
        themes.map((t) => (
          <button type="button" data-theme-val={t.val} aria-label={t.label}>
            <i class={t.icon} />
          </button>
        ))
      }
    </div>
  </div>
  <div>
    <span class="drawer-group-label" data-i18n="settings.language"
      >Language</span
    >
    <div class="segmented">
      {
        langs.map((l) => (
          <button type="button" data-lang={l.val}>
            {l.short}
          </button>
        ))
      }
    </div>
  </div>
</aside>

<script>
  const navbar = document.getElementById("navbar") as HTMLElement;
  const setOpen = (open: boolean) =>
    document.body.classList.toggle("drawer-open", open);

  document
    .getElementById("menu-open")
    ?.addEventListener("click", () => setOpen(true));
  document
    .getElementById("menu-close")
    ?.addEventListener("click", () => setOpen(false));
  document
    .getElementById("drawer-backdrop")
    ?.addEventListener("click", () => setOpen(false));
  document
    .querySelectorAll(".drawer-links a")
    .forEach((a) => a.addEventListener("click", () => setOpen(false)));
  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });

  const onScroll = () =>
    navbar.classList.toggle("scrolled", window.scrollY > 12);
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  const navLinks = document.querySelectorAll<HTMLElement>(
    ".nav-links .nav-link[data-section]",
  );
  const sectionObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        navLinks.forEach((link) =>
          link.classList.toggle(
            "active",
            link.dataset.section === entry.target.id,
          ),
        );
      });
    },
    { rootMargin: "-45% 0px -50% 0px" },
  );
  navLinks.forEach((l) => {
    const section = document.getElementById(l.dataset.section as string);
    if (section) sectionObserver.observe(section);
  });
</script>
